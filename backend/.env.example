# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,https://www.nextdynamix.com

# Database (Postgres 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://nextdynamix:nextdynamix@localhost:5432/nextdynamix

# Redis (rate limiting)
REDIS_URL=redis://localhost:6379/0

# HubSpot CRM
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# RAG / ingestion sources
SITE_BASE_URL=https://www.nextdynamix.com
CMS_BASE_URL=http://localhost:1337
CMS_API_TOKEN=

# Lead notifications
NOTIFICATION_EMAIL=hello@nextdynamix.com
